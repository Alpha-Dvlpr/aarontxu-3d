{% assign products = site.data.aarontxu_3d.productsAndServices.elements | where_exp: "product", "product.unavailable != true" %}{ {% for product in products %}{{ product.id | jsonify }}: { "name": {{ product.title | default: product.category.name | jsonify }}, "price": {{ product.price | default: 0 | jsonify }}, "priceLabel": {{ product.price_label | default: '' | jsonify }}, "image": {{ product.images.first | relative_url | default: '' | jsonify }}, "extras": { {% for extra in product.extras %}{{ extra.id | jsonify }}: { "label": {{ extra.label | jsonify }}, "price": {{ extra.price | default: 0 | jsonify }} }{% unless forloop.last %}, {% endunless %}{% endfor %} } }{% unless forloop.last %}, {% endunless %}{% endfor %} }
