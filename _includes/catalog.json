{% comment %}Lo leen la cesta (script.js) y el Worker. Un producto con opciones da una entrada por opción, con clave «PROD_XX/opcion»; el producto en sí no se puede comprar.{% endcomment %}{% assign products = site.data.aarontxu_3d.productsAndServices.elements | where_exp: "product", "product.unavailable != true" %}{% assign separator = "" %}{ {% for product in products %}{% assign product_page = site.pages | where: "product_id", product.id | first %}{% capture url %}{% if product_page %}{{ product_page.url | relative_url | jsonify }}{% else %}""{% endif %}{% endcapture %}{% assign product_name = product.title | default: product.category.name %}{% if product.options %}{% for option in product.options %}{% capture option_name %}{{ product_name }} – {{ option.label }}{% endcapture %}{{ separator }}{{ product.id | append: "/" | append: option.id | jsonify }}: { "url": {{ url }}, "name": {{ option_name | jsonify }}, "price": {{ option.price | default: 0 | jsonify }}, "priceLabel": "", "image": {{ option.image | default: product.images.first | relative_url | default: '' | jsonify }}, "extras": { {% for extra in option.extras %}{{ extra.id | jsonify }}: { "label": {{ extra.label | jsonify }}, "price": {{ extra.price | default: 0 | jsonify }} }{% unless forloop.last %}, {% endunless %}{% endfor %} } }{% assign separator = ", " %}{% endfor %}{% else %}{{ separator }}{{ product.id | jsonify }}: { "url": {{ url }}, "name": {{ product_name | jsonify }}, "price": {{ product.price | default: 0 | jsonify }}, "priceLabel": {{ product.price_label | default: '' | jsonify }}, "image": {{ product.images.first | relative_url | default: '' | jsonify }}, "extras": { {% for extra in product.extras %}{{ extra.id | jsonify }}: { "label": {{ extra.label | jsonify }}, "price": {{ extra.price | default: 0 | jsonify }} }{% unless forloop.last %}, {% endunless %}{% endfor %} } }{% assign separator = ", " %}{% endif %}{% endfor %} }
